<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>


<VBox spacing="8.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="application.AddressBookController">
   <padding>
      <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
   </padding>
   <children>
      <ListView fx:id="contactListView" />
      <TextArea fx:id="contactTextArea" editable="false" maxHeight="1.7976931348623157E308" prefHeight="300.0" prefWidth="400.0" style="-fx-background-color: white;" />
   </children>
</VBox>
